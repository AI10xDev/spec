[Unit]
Description=Authenticated HTTPS ingress for Spec sandbox marketplace
After=network-online.target spec-marketplace.service
Wants=network-online.target
Requires=spec-marketplace.service
ConditionPathExists=/var/lib/spec-marketplace/private/ready

[Service]
Type=simple
User=spec-marketplace
Group=spec-marketplace
UMask=0077
StateDirectory=spec-marketplace-tls
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/spec-marketplace-tls
Environment=XDG_CONFIG_HOME=/var/lib/spec-marketplace-tls
ExecStart=/usr/bin/caddy run --config /var/lib/spec-marketplace/private/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spec-marketplace-tls
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
