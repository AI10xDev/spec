[Unit]
Description=Fail-closed HTTPS standby for Spec sandbox setup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spec-marketplace
Group=spec-marketplace
UMask=0077
StateDirectory=spec-marketplace-tls
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/spec-marketplace-tls
Environment=XDG_CONFIG_HOME=/var/lib/spec-marketplace-tls
ExecStart=/usr/bin/caddy run --config /etc/spec-marketplace/standby.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spec-marketplace-tls
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
