import json, os, re, selectors, signal, subprocess, tempfile, time, urllib.request

with tempfile.TemporaryDirectory(prefix='spec-launch-', dir='/tmp/opencode') as workspace:
    env = dict(os.environ, SPEC_WORKSPACE=workspace, SPEC_PORT='0')
    process = subprocess.Popen(['/home/emmanuel/spec/run.sh'], cwd='/tmp/opencode', env=env,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    output = b''
    deadline = time.monotonic() + 180
    try:
        while time.monotonic() < deadline:
            for key, _ in selector.select(timeout=1):
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    raise RuntimeError('Launcher exited before startup:\n' + output.decode(errors='replace'))
                output += chunk
            match = re.search(rb'Spec: (http://127\.0\.0\.1:\d+)/#token=([^\s]+)', output)
            if match:
                base, token = (value.decode() for value in match.groups())
                request = urllib.request.Request(base + '/api/config', headers={'Authorization': 'Bearer ' + token})
                with urllib.request.urlopen(request, timeout=5) as response:
                    config = json.load(response)
                assert config['execution'] is True, config
                with urllib.request.urlopen(base, timeout=5) as response:
                    assert response.status == 200
                print('PASS: run.sh built the app, started from another directory, served the UI, and /api/config reports execution=true.')
                break
        else:
            raise RuntimeError('Startup timed out:\n' + output.decode(errors='replace'))
    finally:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()
        selector.close()
