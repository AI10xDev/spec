root = pathlib.Path('/home/emmanuel/spec')
with tempfile.TemporaryDirectory(dir='/tmp/opencode') as tmp:
    home = pathlib.Path(tmp)
    projects = home / "projects with ' quotes"
    projects.mkdir()
    (home / '.bash_aliases').write_text('spec() { printf "%s|%s|%s\\n" "$PWD" "$1" "$2" >> "$HOME/calls"; [[ "${2##*/}" != fail.md ]]; }\n')
    for name in ['a space.md', 'fail.md', 'z-last', 'skip.out', '.hidden.md']:
        (projects / name).write_text('test')
    (projects / 'nested').mkdir()
    (projects / 'link.md').symlink_to(projects / 'a space.md')
    env = dict(os.environ, HOME=tmp)
    script = str(root / 'scripts/build-projects.bash')
    result = subprocess.run(['bash', script, str(projects), '--check'], env=env, capture_output=True, text=True)
