import json, os, pathlib, re, selectors, signal, subprocess, tempfile, time, urllib.request
root = pathlib.Path('/home/emmanuel/spec')
with tempfile.TemporaryDirectory(prefix='spec-launch-', dir='/tmp/opencode') as workspace:
    env = dict(os.environ, SPEC_WORKSPACE=workspace, SPEC_PORT='0')
    for key in ('SPEC_SSH_TARGET', 'SPEC_SSH_KEY', 'SPEC_SSH_WORKSPACE', 'SPEC_COMMAND'):
        env.pop(key, None)
    p = subprocess.Popen([str(root / 'ops.sh')], cwd='/tmp/opencode', env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
    output = b''
    try:
        sel = selectors.DefaultSelector()
        sel.register(p.stdout, selectors.EVENT_READ)
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            if not sel.select(timeout=1):
                continue
            chunk = os.read(p.stdout.fileno(), 65536)
            if not chunk:
                raise RuntimeError(output.decode())
            output += chunk
            match = re.search(rb'Spec: (http://127\.0\.0\.1:\d+)/#token=([a-f0-9]+)', output)
            if match:
                url, token = (v.decode() for v in match.groups())
                req = urllib.request.Request(url + '/api/config', headers={'Authorization': 'Bearer ' + token})
                with urllib.request.urlopen(req, timeout=5) as response:
                    config = json.load(response)
                assert config['execution'] is True, config
                print('ops.sh startup passed from another directory; authenticated API confirms remote execution enabled.')
                break
        else:
            raise RuntimeError('Startup timed out')
    finally:
        os.killpg(p.pid, signal.SIGTERM)
        p.wait(timeout=10)
PY
