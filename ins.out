[0m$ [0mpython3 - <<'PY'
import os
from pathlib import Path
import subprocess
import tempfile

root = Path('/home/emmanuel/spec')
with tempfile.TemporaryDirectory(prefix='spec-launcher-', dir='/tmp/opencode') as temp:
    tmp = Path(temp)
    bindir = tmp / 'bin'
    bindir.mkdir()
    log = tmp / 'calls'
    for name in ('cargo', 'bun'):
        stub = bindir / name
        stub.write_text('#!/bin/bash\nprintf "%s|%s|%s|%s\\n" "${0##*/}" "$*" "$PWD" "${SPEC_SSH_KEY-UNSET}" >> "$CALL_LOG"\n')
        stub.chmod(0o755)
    key = tmp / 'key with spaces'
    key.write_text('fixture, not a real private key')
    home = tmp / 'home'
    home.mkdir()
    (home / 'identity').write_text('fixture')
    env = dict(os.environ, PATH=f'{bindir}:{os.environ["PATH"]}', CALL_LOG=str(log), HOME=str(home), SPEC_WORKSPACE=str(tmp / 'workspace'))
    env.pop('SPEC_SSH_KEY', None)
    cases = [(None, 'UNSET'), ('', 'UNSET'), (str(key), str(key)), ('key with spaces', str(key)), ('~/identity', str(home / 'identity'))]
    for value, expected in cases:
        log.unlink(missing_ok=True)
        case_env = env.copy()
        if value is not None:
            case_env['SPEC_SSH_KEY'] = value
        result = subprocess.run([str(root / 'ops.sh')], cwd=tmp, env=case_env, capture_output=True, text=True)
        assert result.returncode == 0, result.stderr
        calls = log.read_text().splitlines()
        assert len(calls) == 4, calls
        assert all(line.endswith('|' + expected) for line in calls), calls
        assert calls[-2].startswith('cargo|build --release --locked|'), calls
        assert calls[-1].startswith('cargo|run --release --locked|'), calls
    for value in [str(tmp / 'missing'), str(tmp)]:
        log.unlink(missing_ok=True)
        result = subprocess.run([str(root / 'ops.sh')], cwd=tmp, env=dict(env, SPEC_SSH_KEY=value), capture_output=True, text=True)
        assert result.returncode != 0
        assert 'not a readable local private-key file' in result.stderr
        assert not log.exists(), 'Invalid key must fail before building'
    log.unlink(missing_ok=True)
    result = subprocess.run([str(root / 'build.sh')], cwd=tmp, env=dict(env, SPEC_SSH_KEY=str(tmp / 'missing')), capture_output=True, text=True)
    assert result.returncode == 0, result.stderr
    assert len(log.read_text().splitlines()) == 3
print('Launcher smoke checks passed: omitted/empty/absolute/relative/tilde keys, missing/directory rejection before build, and standalone build from another directory.')
PY
