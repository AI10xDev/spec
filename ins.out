-SPEC_SSH_TARGET="opencode@4.197.157.17" SPEC_SSH_KEY="$HOME/.ssh/opencode-dev-aue_ed25519" SPEC_SSH_WORKSPACE="/home/opencode/spec" SPEC_WORKSPACE="$HOME/specs" ./run.sh
+#!/usr/bin/env bash
+set -euo pipefail
+
+root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+
+export SPEC_SSH_TARGET="${SPEC_SSH_TARGET:-opencode@4.197.157.17}"
+export SPEC_SSH_WORKSPACE="${SPEC_SSH_WORKSPACE:-/home/opencode/spec}"
+export SPEC_WORKSPACE="${SPEC_WORKSPACE:-$HOME/specs}"
+
+# Resolve the identity on the local machine before run.sh changes directories
+# or builds anything. An omitted/empty identity uses SSH config or ssh-agent.
+if [[ -n "${SPEC_SSH_KEY:-}" ]]; then
+  key="$SPEC_SSH_KEY"
+  case "$key" in
+    '~/'*) key="$HOME/${key:2}" ;;
+  esac
+  if [[ ! -f "$key" || ! -r "$key" ]]; then
+    printf 'SPEC_SSH_KEY is not a readable local private-key file: %s\n' "$key" >&2
+    printf 'Set SPEC_SSH_KEY to an existing key on this computer, or unset it to use SSH config/ssh-agent.\n' >&2
+    exit 1
+  fi
+  SPEC_SSH_KEY="$(realpath -e -- "$key")"
+  export SPEC_SSH_KEY
+else
+  unset SPEC_SSH_KEY
+fi
+
+exec "$root/run.sh"
