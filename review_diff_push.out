@@ -87,7 +87,10 @@ h2 { margin: 8px 0 0; font-size: 17px; font-weight: 500; overflow-wrap: anywhere
 .completion-ghost { position: absolute; left: 0; top: 0; color: var(--subtle); white-space: pre; line-height: normal; }
 .completion-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; min-height: 42px; padding: 8px 16px; color: var(--muted); font-size: 10px; border-bottom: 1px solid var(--border); }
