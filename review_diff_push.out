import os
from pathlib import Path
import subprocess
import tempfile

root = Path.cwd()
with tempfile.TemporaryDirectory(prefix='spec-review-', dir='/tmp/opencode') as tmp:
    home = Path(tmp)
    project = home / "project with 'quotes"
    project.mkdir()
    for name in ['a.md', 'b.txt', 'c.spec', 'plain', '.hidden.md', 'ignored.out', 'ignored.json']:
        (project / name).write_text('fixture')
    (project / 'linked.md').symlink_to(project / 'a.md')
    (project / 'nested.md').mkdir()
    (home / '.bash_aliases').write_text('spec() { printf "fixture: %s\\n" "$2"; [[ "$2" != */b.txt ]]; }\n')
    env = dict(os.environ, HOME=str(home))
    script = root / 'scripts/build-projects.bash'
    check = subprocess.run(['bash', str(script), str(project), '--check'], env=env, text=True, capture_output=True)
    assert check.returncode == 0, check.stderr
    assert 'Found 4 spec(s)' in check.stdout, check.stdout
    assert not (project / '.spec-runs').exists()
    run = subprocess.run(['bash', str(script), str(project)], env=env, text=True, capture_output=True)
    assert run.returncode == 1, run.stdout + run.stderr
    assert 'Built 4 spec(s); 1 failed.' in run.stdout, run.stdout
    assert len(list((project / '.spec-runs').glob('batch-*/*.out'))) == 4
    fake_ssh = home / 'ssh'
    fake_ssh.write_text('#!/usr/bin/env bash\nexec bash -c "${!#}"\n')
    fake_ssh.chmod(0o700)
    env.update(SPEC_SSH_TARGET='user@fixture', SPEC_SSH_BINARY=str(fake_ssh), SPEC_SSH_KEY='', SPEC_SSH_WORKSPACE=str(project))
    launcher = subprocess.run([str(root / 'remote-build.sh'), '--check'], env=env, text=True, capture_output=True)
    assert launcher.returncode == 0, launcher.stdout + launcher.stderr
    assert 'Found 4 spec(s)' in launcher.stdout, launcher.stdout
print('Launcher checks passed: input filtering, failure continuation, per-spec logs, and quoted remote paths.')
PY
