+/* Keep status text on its own row so suggestions do not reflow the controls
+   and shrink a scrolled editor after the caret has been positioned. */
+.completion-controls #completion-help { flex-basis: 100%; order: 1; }
+.completion-controls button { margin-left: auto; padding: 3px 7px; font-size: 10px; }
 .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; border-top: 1px solid var(--border); padding: 12px; font-size: 10px; color: var(--muted); }
 .toolbar div { display: flex; flex-wrap: wrap; gap: 6px; }
 .toolbar button { font-size: 11px; padding: 7px 9px; }
