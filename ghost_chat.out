from pathlib import Path
for d in Path('/proc').iterdir():
 if not d.name.isdigit(): continue
 try:
  exe=(d/'exe').resolve()
  if exe.name not in ['spec','specific-editor']:continue
  env=dict(x.split(b'=',1) for x in (d/'environ').read_bytes().split(b'\0') if b'=' in x)
  print('pid:',d.name,'exe:',exe,'cwd:',(d/'cwd').resolve())
  for k in [b'AZURE_OPENAI_ENDPOINT',b'AZURE_OPENAI_API_KEY',b'DEPLOYMENT_NAME',b'SPEC_WORKSPACE',b'SPEC_AI_ENV_FILE']:
   print(' ',k.decode()+':',('set' if env.get(k) else 'unset'))
 except (OSError,PermissionError):pass
