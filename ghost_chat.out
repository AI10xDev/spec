import subprocess,os,tempfile,json,urllib.request,urllib.error,selectors
root='/home/emmanuel/spec'
env=os.environ.copy()
for k in list(env):
 if k.startswith('SPEC_SSH_') or k.startswith('AZURE_OPENAI_') or k in ['SPEC_COMMAND','SPEC_AI_ENV_FILE','DEPLOYMENT_NAME']:env.pop(k)
with tempfile.TemporaryDirectory(prefix='spec-ai-check-',dir='/tmp/opencode') as workspace:
 env.update(SPEC_WORKSPACE=workspace,SPEC_PORT='0',SPEC_UI_DIR=root+'/frontend/dist')
 server=subprocess.Popen([root+'/backend/target/debug/spec'],cwd=root+'/backend',env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
 try:
  selector=selectors.DefaultSelector();selector.register(server.stdout,selectors.EVENT_READ)
  if not selector.select(15):raise RuntimeError('Server startup timed out')
  line=server.stdout.readline().strip()
  if not line.startswith('Spec: '):raise RuntimeError('Server did not start')
  url,token=line.removeprefix('Spec: ').split('/#token=',1)
  def request(path,body=None):
   data=None if body is None else json.dumps(body).encode()
   req=urllib.request.Request(url+path,data=data,headers={'Authorization':'Bearer '+token,'Content-Type':'application/json'})
   try:
    with urllib.request.urlopen(req,timeout=70) as response:return json.load(response)
   except urllib.error.HTTPError as e:
    print(path,'HTTP status:',e.code)
    # Backend errors are deliberately credential-free, but only print the status.
    raise RuntimeError('API check failed') from None
  config=request('/api/config')
  print('Rust API config:',json.dumps(config))
  assert config['chat'] and config['completion']
  response=request('/api/chat',{'name':'connection-check','spec':'','unsaved':True,'output':None,'messages':[{'role':'user','content':'Reply with exactly OK.'}]})
  assert response.get('answer','').strip()
