1: # shellcheck shell=bash
2: 
3: _SPECIFIC_INSTALLED_HOME=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
4: 
5: _specific_home() {
6:   printf '%s\n' "${SPECIFIC_HOME:-$_SPECIFIC_INSTALLED_HOME}"
7: }
8: 
9: _specific_command() {
10:   local name=$1
11:   local installed
12:   installed="$(_specific_home)/bin/$name"
13:   if [[ -x "$installed" ]]; then
14:     printf '%s\n' "$installed"
15:   elif command -v -- "$name" >/dev/null 2>&1; then
16:     command -v -- "$name"
17:   else
18:     printf 'specific command is not installed: %s\n' "$name" >&2
19:     return 1
20:   fi
21: }
22: 
23: run_goal() {
24:   local runner
25:   runner=$(_specific_command specific-run-build) || return
26:   "$runner" "$@"
27: }
28: 
29: plan_goal() {
30:   local runner
31:   runner=$(_specific_command specific-run-plan) || return
32:   "$runner" "$@"
33: }
34: 
35: spec() {
36:   local state_dir=${SPECIFIC_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/specific}
37:   local history_file="$state_dir/saved-files"
38:   local spec_file='' line='' directory='' base=''
39: 
40:   if [[ "${1:-}" == build ]]; then
41:     shift
42:     if (( $# > 1 )); then
43:       printf 'Usage: spec build [spec-file]\n' >&2
44:       return 1
45:     fi
46: 
47:     if (( $# == 1 )); then
48:       spec_file=$1
49:       if [[ ! -f "$spec_file" ]]; then
50:         printf 'Spec file is not a regular file: %s\n' "$spec_file" >&2
51:         return 1
52:       fi
53:       directory=$(dirname -- "$spec_file")
54:       base=$(basename -- "$spec_file")
55:       spec_file=$(cd -- "$directory" && printf '%s/%s\n' "$PWD" "$base") || return
56:     else
57:       if [[ ! -s "$history_file" ]]; then
58:         printf 'No saved spec is available. Save one with spec or pass a file.\n' >&2
59:         return 1
60:       fi
61:       while IFS= read -r line || [[ -n "$line" ]]; do
62:         spec_file=$line
63:       done < "$history_file"
64:       if [[ -z "$spec_file" ]]; then
65:         printf 'No saved spec is available. Save one with spec or pass a file.\n' >&2
66:         return 1
67:       fi
68:       if [[ ! -f "$spec_file" ]]; then
69:         printf 'Saved spec is no longer available: %s\n' "$spec_file" >&2
70:         return 1
71:       fi
72:     fi
73:     run_goal "$spec_file"
74:     return
75:   fi
76: 
77:   local editor runner
78:   editor="$(_specific_home)/editor/specific-editor"
79:   if [[ ! -x "$editor" ]]; then
80:     editor=$(command -v specific-editor 2>/dev/null) || {
81:       printf 'specific editor is not installed. Run install.sh.\n' >&2
82:       return 1
83:     }
84:   fi
85:   runner=${KIBI_RUN_COMMAND:-}
86:   if [[ -z "$runner" ]]; then
87:     runner=$(_specific_command specific-run-build) || return
88:   fi
89:   KIBI_RUN_COMMAND="$runner" \
90:     KIBI_SAVE_COPY_DIR="${SPECIFIC_SPECS_DIR:-$HOME/specs}" \
91:     KIBI_SAVE_HISTORY_FILE="$history_file" \
92:     XDG_DATA_DIRS="$(_specific_home)/editor/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" \
93:     "$editor" "$@"
94: }
