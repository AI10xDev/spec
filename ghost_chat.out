import json,os,re
from pathlib import Path
source=Path.home()/'.config/opencode/opencode.jsonc'
config=json.loads(source.read_text())
azure=config['providers']['azure']
settings=azure['settings']
model=config['model'].split('#',1)[0]
if not model.startswith('azure/'):
 raise SystemExit('Configured default model is not Azure; deployment selection needed')
model=model.split('/',1)[1]
deployment=azure.get('models',{}).get(model,{}).get('modelID',model)
resource=settings['resourceName']
key=settings['apiKey']
if not re.fullmatch(r'[A-Za-z0-9-]+',resource):raise SystemExit('Unexpected Azure resource format')
if not re.fullmatch(r'[A-Za-z0-9_.-]+',deployment):raise SystemExit('Unexpected Azure deployment format')
if not key or not key.isascii() or any(c.isspace() for c in key) or any(c in key for c in "'\\\"${}"):
 raise SystemExit('Azure credential needs resolution before import')
endpoint=settings.get('baseURL',f'https://{resource}.openai.azure.com/openai/v1')
if not endpoint.startswith('https://') or any(c in endpoint for c in "'\r\n"):
 raise SystemExit('Unexpected Azure endpoint format')
contents='# Local Azure settings imported from the installed spec build provider.\n'+''.join(f"{name}='{value}'\n" for name,value in [('AZURE_OPENAI_ENDPOINT',endpoint),('AZURE_OPENAI_API_KEY',key),('DEPLOYMENT_NAME',deployment)])
target=Path('/home/emmanuel/spec/.env')
fd=os.open(target,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
with os.fdopen(fd,'w') as out:out.write(contents)
print('Created /home/emmanuel/spec/.env (0600); endpoint, key, and configured Azure deployment imported. Values withheld.')
