from pathlib import Path
import json,re
for n in ['opencode.json','opencode.jsonc']:
 p=Path.home()/'.config/opencode'/n
 if not p.is_file():continue
 t=p.read_text()
 # Print structural properties, withholding all scalar contents.
 print('Config:',p)
 try:
  d=json.loads(t)
 except json.JSONDecodeError:
  print('JSONC property names:', sorted(set(re.findall(r'"([^"\n]+)"\s*:',t))))
  continue
 def walk(v,path=''):
  if isinstance(v,dict):
   for k,x in v.items():walk(x,path+'.'+k)
  elif isinstance(v,list):
   for i,x in enumerate(v):walk(x,path+f'[{i}]')
  else:print(path+': '+('set' if v else 'empty'))
 walk(d)
