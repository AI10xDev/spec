++        let stderr = String::from_utf8(output.stderr).unwrap();
++        assert!(stderr.contains(expected), "{stderr}");
++        assert!(!stderr.contains("mock-secret"));
++        assert!(
++            !String::from_utf8(output.stdout)
++                .unwrap()
++                .contains("mock-secret")
++        );
++    }
++}
