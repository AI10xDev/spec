import pathlib,re
h=pathlib.Path.home()
for n in ['.bashrc','.bash_aliases','.profile','.bash_profile','.zshrc']:
 p=h/n
 if p.is_file():
  for i,l in enumerate(p.read_text().splitlines(),1):
   if re.search(r'alias\s+spec=|function\s+spec\b|\bspec\s*\(\)|AZURE_OPENAI|DEPLOYMENT_NAME',l):
    names=sorted(set(re.findall(r'\b(?:AZURE_[A-Z0-9_]+|DEPLOYMENT_NAME)\b',l)))
    print(f'{p}:{i}: spec alias/function or Azure config; variables={names}')
